[
  {
    "origin": [
      "https://crickflow.web.app",
      "https://crickflow.firebaseapp.com",
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE"],
    "maxAgeSeconds": 3600,
    "responseHeader": ["Content-Type", "Content-Disposition", "Authorization", "x-goog-resumable"]
  },
  {
    "origin": ["*"],
    "method": ["GET", "HEAD"],
    "maxAgeSeconds": 3600,
    "responseHeader": ["Content-Type", "Access-Control-Allow-Origin"]
  }
]
