rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImageJpeg() {
      return request.resource.contentType.matches('image/(jpeg|jpg)');
    }

    function isTeamImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isImagePng() {
      return request.resource.contentType == 'image/png';
    }

    function isProfileImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function under2Mb() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    function under5Mb() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function under512Kb() {
      return request.resource.size < 512 * 1024;
    }

    function under25Mb() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // Single Firestore read per evaluation (deduped by path).
    // firestore.get() on a missing doc is an error in Storage rules (there is
    // no `.exists` on the result), so always check firestore.exists() first.
    function teamSnapshot(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId));
    }

    function teamDocExists(teamId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId));
    }

    function isTeamCreator(teamId) {
      return isSignedIn()
        && teamDocExists(teamId)
        && teamSnapshot(teamId).data.get('createdBy', '') == request.auth.uid;
    }

    // Profile/cover/logo upload during create (before the team doc exists,
    // atomic create) or by the creator afterwards. Same for every signed-in
    // user; org membership or staff roles don't matter here.
    function canWriteTeamImages(teamId) {
      return isSignedIn() && (
        !teamDocExists(teamId)
        || teamSnapshot(teamId).data.get('createdBy', '') == request.auth.uid
      );
    }

    function isOwnTeamProfileFile(name) {
      return name == 'profile_' + request.auth.uid + '.jpg';
    }

    function isOwnTeamCoverFile(name) {
      return name == 'cover_' + request.auth.uid + '.jpg';
    }

    // Legacy logo path (still written as profile alias in older clients).
    function isOwnTeamLogoFile(name) {
      return name == 'logo_' + request.auth.uid + '.jpg';
    }

    function isOwnTeamImageFile(name) {
      return isOwnTeamProfileFile(name)
        || isOwnTeamCoverFile(name)
        || isOwnTeamLogoFile(name);
    }

    function playerDocument(playerId) {
      return firestore.get(/databases/(default)/documents/players/$(playerId));
    }

    function canManagePlayerPhoto(playerId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/players/$(playerId))
        && (
          playerId == request.auth.uid
          || playerDocument(playerId).data.get('userId', '') == request.auth.uid
          || playerDocument(playerId).data.get('userId', null) == null
          || playerDocument(playerId).data.get('userId', '') == ''
        );
    }

    function isOwnPlayerPhotoFile(name) {
      return name == 'photo_' + request.auth.uid + '.jpg';
    }

    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && fileName.matches('profile\\.(jpg|jpeg|png|webp)')
        && isProfileImage()
        && under2Mb();
    }

    match /teams/{teamId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (
        (
          isOwnTeamImageFile(fileName)
          && isTeamImage()
          && (
            (isOwnTeamCoverFile(fileName) && under5Mb())
            || under2Mb()
          )
          && canWriteTeamImages(teamId)
        )
        || (
          fileName == 'invite_qr.png'
          && isTeamCreator(teamId)
          && isImagePng()
          && under512Kb()
        )
      );
      // Undo an upload when the team create fails (no orphan images).
      allow delete: if isSignedIn()
        && isOwnTeamImageFile(fileName)
        && canWriteTeamImages(teamId);
    }

    match /players/{playerId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && isOwnPlayerPhotoFile(fileName)
        && canManagePlayerPhoto(playerId)
        && isImageJpeg()
        && under2Mb();
    }

    match /tournaments/{tournamentId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && fileName.matches('(banner|logo|thumbnail)_.*\\.jpg')
        && isImageJpeg()
        && under5Mb();
      // Undo your own upload when the tournament create fails.
      allow delete: if isSignedIn()
        && fileName.matches('(banner|logo|thumbnail)_' + request.auth.uid + '\\.jpg');
    }

    match /community/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isImageJpeg()
        && under5Mb();
    }

    match /opportunities/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isImageJpeg()
        && under5Mb();
    }

    match /matches/{matchId}/media/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && fileName.matches('CM[0-9]+\\.(jpg|jpeg|png|mp4)')
        && (
          (
            fileName.matches('CM[0-9]+\\.(jpg|jpeg|png)')
            && request.resource.contentType.matches('image/(jpeg|png)')
            && under2Mb()
          )
          || (
            fileName.matches('CM[0-9]+\\.mp4')
            && request.resource.contentType == 'video/mp4'
            && under25Mb()
          )
        );
    }


    function seriesExists(seriesId) {
      return firestore.exists(/databases/(default)/documents/series/$(seriesId));
    }

    function isSeriesOwner(seriesId) {
      return isSignedIn()
        && seriesExists(seriesId)
        && firestore.get(/databases/(default)/documents/series/$(seriesId))
          .data.superAdminUserId == request.auth.uid;
    }

    function seriesAdminSnap(seriesId) {
      return firestore.get(/databases/(default)/documents/series_admins/$(seriesId + '_' + request.auth.uid));
    }

    function isFullSeriesAdmin(seriesId) {
      let adminId = seriesId + '_' + request.auth.uid;
      return isSeriesOwner(seriesId) || (
        isSignedIn()
        && firestore.exists(/databases/(default)/documents/series_admins/$(adminId))
        && seriesAdminSnap(seriesId).data.get('status', '') == 'active'
        && seriesAdminSnap(seriesId).data.get('role', 'admin') in ['admin', 'seriesAdmin', '']
      );
    }

    function isSeriesClubAdmin(seriesId, clubId) {
      let adminId = seriesId + '_' + clubId + '_' + request.auth.uid;
      return isSignedIn()
        && clubId is string
        && clubId.size() > 0
        && firestore.exists(/databases/(default)/documents/series_club_admins/$(adminId))
        && firestore.get(/databases/(default)/documents/series_club_admins/$(adminId))
          .data.get('status', '') == 'active';
    }

    function isRegistrationImageName(fileName) {
      return fileName.matches('(photo|doc)_.*\\.(jpg|jpeg|png|webp)');
    }

    function canViewSeriesRegistrationDoc(seriesId, subjectUserId, clubId) {
      return isSignedIn() && (
        request.auth.uid == subjectUserId
        || isFullSeriesAdmin(seriesId)
        || (clubId is string && isSeriesClubAdmin(seriesId, clubId))
      );
    }

    function canWriteSeriesRegistrationDoc(seriesId, subjectUserId, clubId) {
      return canViewSeriesRegistrationDoc(seriesId, subjectUserId, clubId);
    }

    // Series / Orgs logos, covers, registration photos, ID document images.
    // Path prefix is `series/{id}` regardless of organization `kind`.
    match /series/{seriesId}/{fileName} {
      // Logos and covers stay public. Legacy registration photos/docs are
      // visible only to the subject player and full org admins (no club in path).
      allow read: if fileName.matches('(logo|cover)_.*')
        || (
          fileName.matches('(photo|doc)_.*')
          && isSignedIn()
          && (
            fileName.matches('(photo|doc)_' + request.auth.uid + '_.*')
            || isFullSeriesAdmin(seriesId)
          )
        );
      allow write: if isSignedIn()
        && fileName.matches('(logo|cover|photo|doc)_.*\\.(jpg|jpeg|png|webp)')
        && isProfileImage()
        && (
          (fileName.matches('(cover|doc)_.*') && under5Mb())
          || under2Mb()
        )
        && (
          fileName.matches('(logo|cover)_.*')
          || fileName.matches('(photo|doc)_' + request.auth.uid + '_.*')
          || isFullSeriesAdmin(seriesId)
        );
      // Undo your own logo/cover or registration upload when submit fails.
      allow delete: if isSignedIn()
        && (
          fileName.matches('(logo|cover)_' + request.auth.uid + '\\.jpg')
          || fileName.matches('(photo|doc)_' + request.auth.uid + '_.*')
          || (
            fileName.matches('(photo|doc)_.*')
            && isFullSeriesAdmin(seriesId)
          )
        );
    }

    // Private registration documents (ID photos, passport, profile).
    match /series/{seriesId}/registrations/{subjectUserId}/{fileName} {
      allow read: if canViewSeriesRegistrationDoc(seriesId, subjectUserId, '');
      allow write: if canWriteSeriesRegistrationDoc(seriesId, subjectUserId, '')
        && isRegistrationImageName(fileName)
        && isProfileImage()
        && (fileName.matches('doc_.*') ? under5Mb() : under2Mb());
      allow delete: if canWriteSeriesRegistrationDoc(seriesId, subjectUserId, '');
    }

    match /series/{seriesId}/clubs/{clubId}/registrations/{subjectUserId}/{fileName} {
      allow read: if canViewSeriesRegistrationDoc(seriesId, subjectUserId, clubId);
      allow write: if canWriteSeriesRegistrationDoc(seriesId, subjectUserId, clubId)
        && isRegistrationImageName(fileName)
        && isProfileImage()
        && (fileName.matches('doc_.*') ? under5Mb() : under2Mb());
      allow delete: if canWriteSeriesRegistrationDoc(seriesId, subjectUserId, clubId);
    }
  }
}
